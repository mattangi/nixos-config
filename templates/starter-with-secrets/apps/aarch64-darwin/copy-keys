#!/usr/bin/env bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

username=${USER}
export SSH_DIR="${HOME}/.ssh"

handle_no_usb() {
  echo -e "${RED}No USB drive found or mounted.${NC}"
  echo -e "${GREEN}If you have not yet set up your keys, run the script to generate new SSH keys.${NC}"
  exit 1
}

mount_usb() {
  MOUNT_PATH=""
  # macOS에서 외장/USB 볼륨은 보통 /Volumes 아래에 마운트됨
  for vol in /Volumes/*; do
    [[ -d "$vol" ]] || continue
    # 이 스크립트가 필요로 하는 키 파일이 실제로 있는 볼륨만 선택
    if [[ -f "$vol/id_ed25519_agenix" && -f "$vol/id_ed25519_agenix.pub" \
       && -f "$vol/id_ed25519_github" && -f "$vol/id_ed25519_github.pub" ]]; then
      MOUNT_PATH="$vol"
      echo -e "${GREEN}Key USB volume found at ${MOUNT_PATH}.${NC}"
      return 0
    fi
  done

  echo -e "${RED}No USB volume found that contains the required key files.${NC}"
  return 1
}

copy_keys() {
  if [ -z "${MOUNT_PATH}" ]; then
    echo -e "${RED}No USB drive found. Aborting.${NC}"
    exit 1
  fi

  # Ask before overwriting existing agenix keys (default: no)
  if [[ -f "${SSH_DIR}/id_ed25519_agenix" || -f "${SSH_DIR}/id_ed25519_agenix.pub" ]]; then
    echo -e "${RED}Existing agenix SSH key found at ${SSH_DIR}/id_ed25519_agenix (or .pub).${NC}"
    read -r -p "Overwrite agenix SSH key from USB? yes/no [no]: " response
    response=${response:-no}
    if [[ ! "$response" =~ ^[Yy](es)?$ ]]; then
      echo -e "${GREEN}Keeping existing agenix SSH key. Skipping overwrite.${NC}"
      return 0
    fi
  fi

  cp "${MOUNT_PATH}/id_ed25519_agenix.pub" "${SSH_DIR}/"
  cp "${MOUNT_PATH}/id_ed25519_agenix" "${SSH_DIR}/"

  # Private key should be 600. Public key can be 644.
  chmod 600 "${SSH_DIR}/id_ed25519_agenix"
  chmod 644 "${SSH_DIR}/id_ed25519_agenix.pub"
}

setup_ssh_directory() {
  mkdir -p ${SSH_DIR}
}

set_keys() {
  # If default SSH key already exists, ask before overwriting (default: no)
  if [[ -f "${SSH_DIR}/id_ed25519" || -f "${SSH_DIR}/id_ed25519.pub" ]]; then
    echo -e "${RED}Existing default SSH key found at ${SSH_DIR}/id_ed25519 (or .pub).${NC}"
    read -r -p "Overwrite default SSH key with USB 'id_ed25519_github'? yes/no [no]: " response
    response=${response:-no}
    if [[ ! "$response" =~ ^[Yy](es)?$ ]]; then
      echo -e "${GREEN}Keeping existing default SSH key. Skipping overwrite.${NC}"
      return 0
    fi
  fi

  cp "${MOUNT_PATH}/id_ed25519_github.pub" "${SSH_DIR}/id_ed25519.pub"
  cp "${MOUNT_PATH}/id_ed25519_github" "${SSH_DIR}/id_ed25519"
  chmod 600 "${SSH_DIR}/id_ed25519"
  chmod 644 "${SSH_DIR}/id_ed25519.pub"
}

change_ownership() {
  chown ${username}:staff ${SSH_DIR}/id_ed25519{,.pub}
  chown ${username}:staff ${SSH_DIR}/id_ed25519_{agenix,agenix.pub}
}

setup_ssh_directory
mount_usb

if [ -z "${MOUNT_PATH}" ]; then
  handle_no_usb
else
  copy_keys
  set_keys
  change_ownership
fi
